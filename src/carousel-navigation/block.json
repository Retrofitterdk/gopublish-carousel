{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gopublish/carousel-navigation",
	"version": "0.5.0",
	"title": "Carousel Navigation",
	"category": "widgets",
	"icon": "leftright",
	"description": "Previous and next buttons for a carousel.",
	"parent": [ "gopublish/carousel" ],
	"usesContext": [
		"gopublish-carousel/slidesId",
		"gopublish-carousel/rewind"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"layout": {
			"default": {
				"type": "flex",
				"justifyContent": "right",
				"flexWrap": "nowrap"
			},
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": false,
			"allowVerticalAlignment": false,
			"allowJustification": true,
			"allowSizingOnChildren": false
		},
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		}
	},
	"textdomain": "gopublish-carousel",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
