{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gopublish/carousel-navigation",
	"version": "0.6.0",
	"title": "Carousel Navigation",
	"category": "widgets",
	"icon": "leftright",
	"description": "Previous and next buttons for a carousel.",
	"parent": [ "gopublish/carousel" ],
	"attributes": {
		"icon": {
			"type": "string"
		},
		"overlay": {
			"type": "boolean",
			"default": false
		},
		"iconColor": {
			"type": "string"
		},
		"customIconColor": {
			"type": "string"
		},
		"iconHoverColor": {
			"type": "string"
		},
		"customIconHoverColor": {
			"type": "string"
		},
		"buttonColor": {
			"type": "string"
		},
		"customButtonColor": {
			"type": "string"
		},
		"buttonHoverColor": {
			"type": "string"
		},
		"customButtonHoverColor": {
			"type": "string"
		},
		"buttonPadding": {
			"type": "object"
		},
		"iconSize": {
			"type": "number"
		}
	},
	"usesContext": [
		"gopublish-carousel/slidesId",
		"gopublish-carousel/rewind"
	],
	"supports": {
		"html": false,
		"reusable": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"width": true
			}
		},
		"layout": {
			"default": {
				"type": "flex",
				"justifyContent": "right",
				"flexWrap": "nowrap"
			},
			"allowSwitching": false,
			"allowInheriting": false,
			"allowOrientation": false,
			"allowVerticalAlignment": false,
			"allowJustification": true,
			"allowSizingOnChildren": false
		},
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		}
	},
	"textdomain": "gopublish-carousel",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
