#. Plugin Name of the plugin
#: gopublish-carousel.php
msgid "Go:Publish Carousel"
msgstr ""

#. Author of the plugin
#: gopublish-carousel.php
msgid "Retrofitter"
msgstr ""

#: gopublish-carousel.php:835
#: build/carousel-navigation/index.js:1
msgid "Previous slide"
msgstr "Forrige dias"

#: gopublish-carousel.php:841
#: build/carousel-navigation/index.js:1
msgid "Next slide"
msgstr "Næste dias"

#. translators: Spoken by screen readers to describe the carousel block.
#: build/carousel/render.php:162
msgid "carousel"
msgstr "karrusel"

#. translators: Spoken by screen readers to describe a single slide.
#: gopublish-carousel.php:512
msgid "slide"
msgstr "dias"

#. translators: Announced after moving the carousel when one slide is fully visible. 1: Slide number, 2: Total number of slides.
#: build/carousel/render.php:200
#, php-format
msgid "Slide %1$d of %2$d"
msgstr "Dias %1$d af %2$d"

#. translators: 1: Slide number, 2: Total number of slides.
#: gopublish-carousel.php:525
#, php-format
msgid "%1$d of %2$d"
msgstr "%1$d af %2$d"

#: build/carousel-slides/index.js:1
msgid "Add slide"
msgstr "Tilføj dias"

#: build/carousel-slides/index.js:1
msgid "Show all slides"
msgstr "Vis alle dias"

#: build/carousel/index.js:3
msgid "Columns"
msgstr "Kolonner"

#: build/carousel/index.js:3
msgid "Number of slides visible at once."
msgstr "Antal dias, der er synlige ad gangen."

#: build/carousel/index.js:3
msgid "Slides to scroll"
msgstr "Dias pr. skift"

#: build/carousel/index.js:3
msgid "Number of slides to move when navigating. With the cutoff effect, it must be lower than the number of columns."
msgstr "Antal dias, der flyttes ved hvert skift. Med beskæringseffekten skal det være lavere end antallet af kolonner."

#: build/carousel/index.js:3
msgid "Use cutoff effect"
msgstr "Brug beskæringseffekt"

#: build/carousel/index.js:4
msgid "Carousel label"
msgstr "Karrusellens navn"

#: build/carousel-slide/block.json
msgctxt "block title"
msgid "Carousel Slide"
msgstr "Karruseldias"

#: build/carousel-slide/block.json
msgctxt "block description"
msgid "A wrapper block for carousel slides"
msgstr "En indpakningsblok til karruseldias"

#: build/carousel/block.json
msgctxt "block title"
msgid "Carousel"
msgstr "Karrusel"

#: build/carousel/block.json
msgctxt "block description"
msgid "A carousel for blocks using the Interactivity API."
msgstr "En karrusel til blokke, bygget med Interactivity API."

#. translators: Announced after moving the carousel when several slides are fully visible. 1: First visible slide, 2: Last visible slide, 3: Total number of slides.
#: build/carousel/render.php:202
#, php-format
msgid "Slides %1$d to %2$d of %3$d"
msgstr "Dias %1$d til %2$d af %3$d"

#: build/carousel/index.js:4
msgid "Rewind at the end"
msgstr "Start forfra ved slutningen"

#: build/carousel/index.js:4
msgid "On the last slide, Next goes back to the first, and Previous on the first slide goes to the last. When off, the buttons are disabled at the ends."
msgstr "På sidste dias går Næste tilbage til det første, og Forrige på første dias går til det sidste. Når den er slået fra, er knapperne deaktiveret ved enderne."

#. Description of the plugin
#: gopublish-carousel.php
msgid "A carousel block for any blocks, built on native scrolling and the Interactivity API."
msgstr "En karruselblok til alle slags blokke, bygget på browserens egen scrolling og Interactivity API."

#: build/carousel/index.js:1
msgid "Desktop"
msgstr "Computer"

#: build/carousel/index.js:1
msgid "Tablet"
msgstr "Tablet"

#: build/carousel/index.js:1
msgid "Mobile"
msgstr "Mobil"

#. translators: %s: Screen size, e.g. "Tablet".
#: build/carousel/index.js:2
#, js-format
msgid "Changed for %s."
msgstr "Ændret for %s."

#. translators: %s: Larger screen size, e.g. "Desktop".
#: build/carousel/index.js:3
#, js-format
msgid "Same as %s."
msgstr "Samme som %s."

#: build/carousel/index.js:3
msgid "Layout"
msgstr "Layout"

#: build/carousel/index.js:3
msgid "Screen size"
msgstr "Skærmstørrelse"

#: build/carousel/index.js:3
msgid "Desktop settings apply to every screen size unless Tablet or Mobile changes them. Also switches the editor preview."
msgstr "Indstillingerne for Computer gælder for alle skærmstørrelser, medmindre Tablet eller Mobil ændrer dem. Skifter også forhåndsvisningen i editoren."

#: build/carousel/index.js:3
msgid "Partly show the last visible slide (or, with one column, the next slide), hinting that there are more slides to scroll through."
msgstr "Vis det sidste synlige dias delvist (eller, med én kolonne, det næste dias), så det antydes, at der er flere dias at bladre igennem."

#. translators: %s: Larger screen size, e.g. "Desktop".
#: build/carousel/index.js:4
#, js-format
msgid "Reset to %s"
msgstr "Nulstil til %s"

#: build/carousel/index.js:3
#: build/carousel/index.js:4
msgid "Navigation"
msgstr "Navigation"

#: build/carousel-navigation/block.json
msgctxt "block title"
msgid "Carousel Navigation"
msgstr "Karruselnavigation"

#: build/carousel-navigation/block.json
msgctxt "block description"
msgid "Previous and next buttons for a carousel."
msgstr "Knapper til forrige og næste dias i en karrusel."

#: build/carousel-slides/block.json
msgctxt "block title"
msgid "Carousel Slides"
msgstr "Karrusellens dias"

#: build/carousel-slides/block.json
msgctxt "block description"
msgid "The slides of a carousel, in a scrollable row."
msgstr "Karrusellens dias i en række, der kan rulles."

#: build/carousel-pagination/render.php:31
msgid "Choose slide"
msgstr "Vælg dias"

#. translators: Label of a pagination dot. %d: Number of the first slide it scrolls to.
#: build/carousel/render.php:220
#: build/carousel-pagination/index.js:2
#, php-format,js-format
msgid "Go to slide %d"
msgstr "Gå til dias %d"

#: build/carousel-pagination/block.json
msgctxt "block title"
msgid "Carousel Pagination"
msgstr "Karruselpaginering"

#: build/carousel-pagination/block.json
msgctxt "block description"
msgid "Dots for jumping to a position in a carousel."
msgstr "Prikker til at springe til en position i en karrusel."

#: build/carousel/index.js:3
msgid "Add to carousel"
msgstr "Tilføj til karrusel"

#: build/carousel/index.js:3
msgid "Slide"
msgstr "Dias"

#: build/carousel/index.js:3
msgid "Pagination"
msgstr "Paginering"

#: build/carousel-navigation/index.js:1
msgid "Choose icon"
msgstr "Vælg ikon"

#: build/carousel-navigation/index.js:1
msgid "Search icons"
msgstr "Søg efter ikoner"

#: build/carousel-navigation/index.js:1
msgid "No icons found."
msgstr "Ingen ikoner fundet."

#: build/carousel-navigation/index.js:1
msgid "Icon"
msgstr "Ikon"

#: build/carousel-navigation/index.js:1
msgid "Reset"
msgstr "Nulstil"

#: build/carousel-navigation/index.js:1
#: build/carousel-pagination/index.js:1
msgid "Color"
msgstr "Farve"

#: build/carousel-navigation/index.js:1
msgid "Background"
msgstr "Baggrund"

#: build/carousel-navigation/index.js:1
msgid "Previous and Next show the icon mirrored: left- and right-pointing icons both work."
msgstr "Forrige og Næste viser ikonet spejlvendt: ikoner, der peger til venstre eller højre, virker begge."

#: build/carousel-navigation/index.js:1
msgid "Button padding"
msgstr "Knappens indre margen"

#: build/carousel-navigation/index.js:1
msgid "Icon size"
msgstr "Ikonstørrelse"

#: build/carousel-navigation/index.js:1
#: build/carousel-pagination/index.js:1
msgid "In pixels."
msgstr "I pixels."

#: build/carousel-navigation/index.js:1
msgid "Icon (hover & focus)"
msgstr "Ikon (hover og fokus)"

#: build/carousel-navigation/index.js:1
msgid "Background (hover & focus)"
msgstr "Baggrund (hover og fokus)"

#: build/carousel-navigation/index.js:1
msgid "Position"
msgstr "Position"

#: build/carousel-navigation/index.js:1
msgid "Over the slides"
msgstr "Oven på diasene"

#: build/carousel-navigation/index.js:1
msgid "Previous and Next at the edges of the slides. Hidden on mobile, where visitors swipe."
msgstr "Forrige og Næste ved diasenes kanter. Skjult på mobil, hvor de besøgende swiper."

#: build/carousel-pagination/index.js:1
msgid "Dot size"
msgstr "Prikstørrelse"

#: build/carousel-pagination/index.js:1
msgid "Dot spacing"
msgstr "Afstand mellem prikker"

#: build/carousel-pagination/index.js:1
msgid "In pixels. Dots stay at least 24 pixels apart, centre to centre, so they are easy to tap."
msgstr "I pixels. Prikkerne er mindst 24 pixels fra hinanden, målt fra midte til midte, så de er nemme at trykke på."

#: build/carousel-pagination/index.js:1
msgid "Dots"
msgstr "Prikker"

#: build/carousel-pagination/index.js:1
msgid "Current dot"
msgstr "Aktuel prik"

#: build/carousel/index.js:3
msgid "Heading"
msgstr "Overskrift"

#: build/carousel/index.js:3
msgid "Paragraph"
msgstr "Afsnit"

#: build/carousel/index.js:4
msgid "Describes the carousel for screen reader users, e.g. \"Customer testimonials\". With a label, the carousel becomes a landmark they can jump to. Leave empty to use the carousel's heading, if it has one."
msgstr "Beskriver karrusellen for skærmlæserbrugere, f.eks. \"Kundeudtalelser\". Med et navn bliver karrusellen et landmærke, de kan springe direkte til. Lad feltet være tomt for at bruge karrusellens overskrift, hvis den har en."
