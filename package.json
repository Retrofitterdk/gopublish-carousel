{
	"name": "gopublish-carousel",
	"version": "0.4.0",
	"description": "A looping carousel block for any blocks, built on the Interactivity API.",
	"author": "Retrofitter",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --experimental-modules --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --experimental-modules --blocks-manifest",
		"lint:php": "composer run-script lint",
		"lint:php:fix": "composer run-script format"
	},
	"files": [
		"[^.]*"
	],
	"dependencies": {
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/interactivity": "^8.1.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.1.0"
	}
}
